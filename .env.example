# Copy this file to .env and fill in ONE provider block.
# Any OpenAI-compatible chat completions endpoint with tool calling works.
# Model names change often: check your provider's current model list.

# --- Groq (free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free tier, OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# --- Ollama (local, no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b

# Optional: prices per 1M tokens, used only for the cost column in eval reports.
# PRICE_INPUT_PER_M=0
# PRICE_OUTPUT_PER_M=0

# Optional extra request options as JSON. Low reasoning effort cuts output tokens on Groq gpt-oss models.
LLM_EXTRA={"reasoning_effort":"low"}
